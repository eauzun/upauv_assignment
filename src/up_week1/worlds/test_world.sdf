<?xml version="1.0"?>
<sdf version="1.8">
  <world name="up_test_world">
    <physics name="default_physics" type="dart">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.6 0.6 0.6 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.3 0.2 -1</direction>
    </light>
    <model name="piscine">
	    <static>true</static> 
	<link name = "floor">
		<pose>0 0 -2.1 0 0 0</pose>

	<collision name="collision">
		<geometry>
			<box><size>8.4 8.4 0.2</size></box>
		</geometry>
	</collision>

	<visual name ="visual">
		<geometry>
			<box><size>8.4 8.4 0.2</size></box>
		</geometry>
			<material>
				<ambient>0.3 0.45 0.55 1</ambient>
				<diffuse>0.3 0.45 0.55 1</diffuse>
			</material>
	</visual>
	</link>
	<link name="north_wall">
		<pose>0 4.1 -1 0 0 0</pose>
		<collision name="collision">
			<geometry><box><size>8.4 0.2 2</size></box></geometry>
		</collision>
		<visual name = "visual">
			<geometry><box><size>8.4 0.2 2</size></box></geometry>		
			<material>
				<ambient>0.75 0.75 0.78 1 </ambient>
				<diffuse>0.75 0.75 0.78 1 </diffuse>
			</material>
		</visual>
	</link>
	        <link name="south_wall">
                <pose>0 -4.1 -1 0 0 0</pose>
                <collision name="collision">
                        <geometry><box><size>8.4 0.2 2</size></box></geometry>
                </collision>
                <visual name = "visual">
                        <geometry><box><size>8.4 0.2 2</size></box></geometry>
                        <material>
                                <ambient>0.75 0.75 0.78 1 </ambient>
                                <diffuse>0.75 0.75 0.78 1 </diffuse>
                        </material>
                </visual>
        </link>

	        <link name="east_wall">
                <pose>4.1 0 -1 0 0 0</pose>
                <collision name="collision">
                        <geometry><box><size>0.2 8 2</size></box></geometry>
                </collision>
                <visual name = "visual">
                        <geometry><box><size>0.2 8 2</size></box></geometry>
                        <material>
                                <ambient>0.75 0.75 0.78 1 </ambient>
                                <diffuse>0.75 0.75 0.78 1 </diffuse>
                        </material>
                </visual>
	</link>

	        <link name="west_wall">
                <pose>-4.1 0 -1 0 0 0</pose>
                <collision name="collision">
                        <geometry><box><size>0.2 8 2</size></box></geometry>
                </collision>
                <visual name = "visual">
                        <geometry><box><size>0.2 8 2</size></box></geometry>
                        <material>
                                <ambient>0.75 0.75 0.78 1 </ambient>
                                <diffuse>0.75 0.75 0.78 1 </diffuse>
                        </material>
                </visual>
        </link>

</model>

    <model name="fish_1">
        <static>true</static>
        <pose>-1.5 1.5 -1.0 0 0 0.5</pose>
        <link name="link">
                <collision name="body_collision">
                        <pose>0 0 0 0 1.5708 0</pose>
                        <geometry><capsule><radius>0.15</radius><length>0.5</length></capsule></geometry>
                </collision>
                <visual name="body_visual">
                        <pose>0 0 0 0 1.5708 0</pose>
                        <geometry><capsule><radius>0.15</radius><length>0.5</length></capsule></geometry>
                        <material>
                                <ambient>1 0.6 0.1 1</ambient>
                                <diffuse>1 0.6 0.1 1</diffuse>
                        </material>
                </visual>
                <collision name="tail_collision">
                        <pose>-0.45 0 0 0 0 0</pose>
                        <geometry><box><size>0.1 0.02 0.25</size></box></geometry>
                </collision>
                <visual name="tail_visual">
                        <pose>-0.45 0 0 0 0 0</pose>
                        <geometry><box><size>0.1 0.02 0.25</size></box></geometry>
                        <material>
                                <ambient>1 0.6 0.1 1</ambient>
                                <diffuse>1 0.6 0.1 1</diffuse>
                        </material>
                </visual>
        </link>
</model>

    <model name="fish_2">
        <static>true</static>
        <pose>1.5 -0.5 -1.5 0 0 -0.8</pose>
        <link name="link">
                <collision name="body_collision">
                        <pose>0 0 0 0 1.5708 0</pose>
                        <geometry><capsule><radius>0.15</radius><length>0.5</length></capsule></geometry>
                </collision>
                <visual name="body_visual">
                        <pose>0 0 0 0 1.5708 0</pose>
                        <geometry><capsule><radius>0.15</radius><length>0.5</length></capsule></geometry>
                        <material>
                                <ambient>0.2 0.8 0.3 1</ambient>
                                <diffuse>0.2 0.8 0.3 1</diffuse>
                        </material>
                </visual>
                <collision name="tail_collision">
                        <pose>-0.45 0 0 0 0 0</pose>
                        <geometry><box><size>0.1 0.02 0.25</size></box></geometry>
                </collision>
                <visual name="tail_visual">
                        <pose>-0.45 0 0 0 0 0</pose>
                        <geometry><box><size>0.1 0.02 0.25</size></box></geometry>
                        <material>
                                <ambient>0.2 0.8 0.3 1</ambient>
                                <diffuse>0.2 0.8 0.3 1</diffuse>
                        </material>
                </visual>
        </link>
</model>

        <model name="red_target">
        <static>true</static>
        <pose>0 -1.5 -1.99 0 0 0</pose>
        <link name="link">
                <collision name="collision">
                        <geometry><box><size>3 0.15 0.02</size></box></geometry>
                </collision>
                <visual name="visual">
                        <geometry><box><size>3 0.15 0.02</size></box></geometry>
                        <material>
                                <ambient>1 0 0 1</ambient>
                                <diffuse>1 0 0 1</diffuse>
                                <emissive>0.6 0 0 1</emissive>
                        </material>
                </visual>
        </link>
</model>

    <model name="block_1">
        <static>true</static>
        <pose>0 2.0 -1.7 0 0 0</pose>
        <link name="link">
                <collision name="collision">
                        <geometry><cylinder><radius>0.3</radius><length>0.6</length></cylinder></geometry>
                </collision>
                <visual name="visual">
                        <geometry><cylinder><radius>0.3</radius><length>0.6</length></cylinder></geometry>
                        <material>
                                <ambient>0.9 0.9 0.2 1</ambient>
                                <diffuse>0.9 0.9 0.2 1</diffuse>
                        </material>
                </visual>
        </link>
</model>

<model name="fixed_camera">
	<static>true</static>
	<pose>0 -3.8 -1 0 0.25 1.5</pose>
	<link name ="link" >
		<sensor name="camera" type="camera">
			<always_on>true</always_on>
			<update_rate>10</update_rate>
			<topic>camera/image_raw</topic>
			<camera>
				<horizontal_fov>1</horizontal_fov>
				<image>
					<width>640</width>
					<height>480</height>
					<format>R8G8B8</format>
				</image>
				<clip>
					<near>0.1</near>
					<far>20</far>
				</clip>
			</camera>
		</sensor>
	</link>
</model>	
</world>
</sdf>
